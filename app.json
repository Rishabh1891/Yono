{
  "expo": {
    "name": "yono",
    "slug": "yono",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/yono-icon.png",
    "scheme": "yono",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/yono-icon.png"
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/yono-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#663399",
          "image": "./assets/images/yono-icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
